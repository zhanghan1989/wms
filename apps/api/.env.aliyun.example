PORT=3000

# Use Alibaba Cloud RDS MySQL private endpoint
# Example:
# DATABASE_URL="mysql://wms_user:your_password@rm-xxxxxx.mysql.rds.aliyuncs.com:3306/wms_v1"
DATABASE_URL="mysql://wms_user:replace_me@your-rds-endpoint:3306/wms_v1"

JWT_SECRET="replace-with-long-random-secret"
THIRD_PARTY_API_KEY="replace-with-third-party-api-key"
YAMATO_PRINT_MODE="agent"
PRINT_AGENT_API_KEY="replace-with-print-agent-api-key"
UOF_TRACKING_APP_TOKEN="replace-with-uof-app-token"
UOF_TRACKING_APP_KEY="replace-with-uof-app-key"
# UOF_TRACKING_API_URL="http://oms.uofexp.com/webservice/PublicService.asmx/ServiceInterfaceUTF8"
# UOF_TRACKING_SYNC_MAX_PER_RUN=500

# Optional seed defaults
SEED_ADMIN_PASSWORD="Admin@123"
SEED_EMPLOYEE_PASSWORD="Employee@123"
# Amazon Selling Partner API（从密钥管理系统注入真实值）
AMAZON_SP_API_LWA_CLIENT_ID=
AMAZON_SP_API_LWA_CLIENT_SECRET=
AMAZON_SP_API_APPLICATION_ID=
AMAZON_SP_API_OAUTH_REDIRECT_URI=https://wms.fulangke.cn/api/amazon-sp-api/oauth/callback
AMAZON_SP_API_OAUTH_RETURN_URL=https://wms.fulangke.cn/
AMAZON_SP_API_OAUTH_DRAFT=true
AMAZON_SP_API_SELLER_CENTRAL_URL=https://sellercentral.amazon.co.jp
AMAZON_SP_API_ENCRYPTION_KEY=
AMAZON_SP_API_SYNC_CRON="0 0 11 * * *"
AMAZON_SP_API_SYNC_TIMEZONE="Asia/Shanghai"
AMAZON_SP_API_INCLUDE_RECIPIENT=false
