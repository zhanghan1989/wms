  id                     BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  batchId                BigInt               @map("batch_id") @db.UnsignedBigInt
  source                 String               @db.VarChar(16)
  sourceRecordId         BigInt               @map("source_record_id") @db.UnsignedBigInt
  orderId                String?              @map("order_id") @db.VarChar(64)
  skuCode                String?              @map("sku_code") @db.VarChar(128)
  productId              String               @map("product_id") @db.VarChar(128)
  requestedQty           Int                  @map("requested_qty")
  actualQty              Int?                 @map("actual_qty")
  availableStockSnapshot Int                  @default(0) @map("available_stock_snapshot")
  pickingPlanSnapshot    Json?                @map("picking_plan_snapshot")
  dispatchMode           String               @default("overseas") @map("dispatch_mode") @db.VarChar(32)
  shopName               String?              @map("shop_name") @db.VarChar(128)
  shippingName           String?              @map("shipping_name") @db.VarChar(255)
  shipmentTrackingNo     String?              @map("shipment_tracking_no") @db.VarChar(128)
  pickedAt               DateTime?            @map("picked_at")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")
  batch                  OverseasPickingBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, source, sourceRecordId], map: "uq_overseas_picking_batch_items_batch_source_record")
  @@index([batchId, productId])
  @@index([source, sourceRecordId])
  @@index([orderId])
  @@map("overseas_picking_batch_items")
}

model YamatoShipmentBatch {
  id               BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  pickingBatchId   BigInt?                   @unique @map("picking_batch_id") @db.UnsignedBigInt
  exportedFileName String?                   @map("exported_file_name") @db.VarChar(255)
  pdfFileName      String?                   @map("pdf_file_name") @db.VarChar(255)
  pdfFilePath      String?                   @map("pdf_file_path") @db.VarChar(512)
  pdfUploadedAt    DateTime?                 @map("pdf_uploaded_at")
  status           String                    @default("excel_exported") @db.VarChar(32)
  pageCount        Int                       @default(0) @map("page_count")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")
  pages            YamatoShipmentBatchPage[]

  @@index([status, createdAt])
  @@index([pdfUploadedAt])
  @@map("yamato_shipment_batches")
}

model YamatoShipmentBatchPage {
  id               BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  batchId          BigInt              @map("batch_id") @db.UnsignedBigInt
  pageNo           Int                 @map("page_no")
  orderId          String?             @map("order_id") @db.VarChar(64)
  productIds       Json?               @map("product_ids")
  printerValue     String?             @map("printer_value") @db.VarChar(128)
  printerName      String?             @map("printer_name") @db.VarChar(128)
  itemSummary      String?             @map("item_summary") @db.Text
  trackingNo       String?             @map("tracking_no") @db.VarChar(128)
  recipientName    String?             @map("recipient_name") @db.VarChar(255)
  pageText         String?             @map("page_text") @db.Text
  printedAt        DateTime?           @map("printed_at")
  printedProductId String?             @map("printed_product_id") @db.VarChar(128)
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  batch            YamatoShipmentBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  printJobs        PrintJob[]

  @@unique([batchId, pageNo], map: "uq_yamato_shipment_batch_pages_batch_page")
  @@index([batchId, printedAt])
  @@index([orderId])
  @@index([trackingNo])
  @@map("yamato_shipment_batch_pages")
}

model MasterProduct {
  id                BigInt                      @id @default(autoincrement()) @db.UnsignedBigInt
  productId         String                      @unique @map("product_id") @db.VarChar(128)
  productName       String?                     @map("product_name") @db.VarChar(255)
  productType       String?                     @map("product_type") @db.VarChar(128)
  bagBrand          String?                     @map("bag_brand") @db.VarChar(128)
  color             String?                     @db.VarChar(64)
  bagName           String?                     @map("bag_name") @db.VarChar(128)
  bagType           String?                     @map("bag_type") @db.VarChar(64)
  zipperStyle       String?                     @map("zipper_style") @db.VarChar(64)
  style             String?                     @db.VarChar(128)
  pattern           String?                     @db.VarChar(128)
  buckleType        String?                     @map("buckle_type") @db.VarChar(64)
  matchingBagType   String?                     @map("matching_bag_type") @db.VarChar(64)
  length            String?                     @db.VarChar(64)
  width             String?                     @db.VarChar(64)
  patternType       String?                     @map("pattern_type") @db.VarChar(64)
  size              String?                     @db.VarChar(64)
  yamatoPrinterName String?                     @map("yamato_printer_name") @db.VarChar(128)
  stockQty          Int                         @default(0) @map("stock_qty")
  firstStockedAt    DateTime?                   @map("first_stocked_at")
  status            Int                         @default(1) @db.TinyInt
  createdAt         DateTime                    @default(now()) @map("created_at")
  updatedAt         DateTime                    @updatedAt @map("updated_at")
  skus              Sku[]
  boxInventories    MasterProductBoxInventory[]
  stockMovements    StockMovement[]
  inboundItems      InboundOrderItem[]
  syncRecords       MasterProductSyncRecord[]
  rakutenComboItems RakutenComboProductItem[]

  @@index([firstStockedAt], map: "idx_master_products_first_stocked_at")
  @@map("master_products")
}

model RakutenComboProduct {
  id        BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  comboName String                    @unique @map("combo_name") @db.VarChar(255)
  createdAt DateTime                  @default(now()) @map("created_at")
  updatedAt DateTime                  @updatedAt @map("updated_at")
  items     RakutenComboProductItem[]

  @@index([createdAt], map: "rakuten_combo_products_created_at_idx")
  @@map("rakuten_combo_products")
}

model RakutenComboProductItem {
  id        BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  comboId   BigInt              @map("combo_id") @db.UnsignedBigInt
  productId String              @map("product_id") @db.VarChar(128)
  position  Int
  createdAt DateTime            @default(now()) @map("created_at")
  combo     RakutenComboProduct @relation(fields: [comboId], references: [id], onDelete: Cascade)
  product   MasterProduct       @relation(fields: [productId], references: [productId])

  @@unique([comboId, position], map: "uq_rakuten_combo_items_combo_position")
  @@unique([comboId, productId], map: "uq_rakuten_combo_items_combo_product")
  @@index([productId], map: "rakuten_combo_items_product_id_idx")
  @@map("rakuten_combo_product_items")
}

model ReturnRecord {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  senderName     String?  @map("sender_name") @db.VarChar(255)
  carrierName    String?  @map("carrier_name") @db.VarChar(128)
  trackingNo     String?  @map("tracking_no") @db.VarChar(128)
  postalCode     String?  @map("postal_code") @db.VarChar(32)
  address        String?  @db.Text
  phone          String?  @db.VarChar(64)
  packageContent String?  @map("package_content") @db.Text
  salesSite      String?  @map("sales_site") @db.VarChar(128)
  orderNo        String?  @map("order_no") @db.VarChar(128)
  productId      String?  @map("product_id") @db.VarChar(128)
  productName    String?  @map("product_name") @db.VarChar(255)
  isOpenedUsed   Boolean  @default(false) @map("is_opened_used")
  canRestock     Boolean  @default(false) @map("can_restock")
  sourceFileName String?  @map("source_file_name") @db.VarChar(255)
  createdBy      BigInt?  @map("created_by") @db.UnsignedBigInt
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([createdAt], map: "return_records_created_at_idx")
  @@index([trackingNo], map: "return_records_tracking_no_idx")
  @@index([orderNo], map: "return_records_order_no_idx")
  @@index([productId], map: "return_records_product_id_idx")
  @@map("return_records")
}

model PrintJob {
  id           BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  jobType      String                   @default("yamato_label") @map("job_type") @db.VarChar(32)
  status       PrintJobStatus           @default(pending)
  batchPageId  BigInt?                  @map("batch_page_id") @db.UnsignedBigInt
  orderId      String?                  @map("order_id") @db.VarChar(128)
  productId    String                   @map("product_id") @db.VarChar(128)
  printerName  String?                  @map("printer_name") @db.VarChar(128)
  fileName     String                   @map("file_name") @db.VarChar(255)
  filePath     String?                  @map("file_path") @db.VarChar(512)
  trackingNo   String?                  @map("tracking_no") @db.VarChar(64)
  agentName    String?                  @map("agent_name") @db.VarChar(128)
  claimToken   String?                  @unique(map: "uq_print_jobs_claim_token") @map("claim_token") @db.VarChar(64)
  systemJobId  String?                  @map("system_job_id") @db.VarChar(128)
  errorMessage String?                  @map("error_message") @db.VarChar(255)
  queuedAt     DateTime                 @default(now()) @map("queued_at")
  claimedAt    DateTime?                @map("claimed_at")
  completedAt  DateTime?                @map("completed_at")
  failedAt     DateTime?                @map("failed_at")
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")
  batchPage    YamatoShipmentBatchPage? @relation(fields: [batchPageId], references: [id], onDelete: SetNull)

  @@index([status, queuedAt], map: "print_jobs_status_queued_at_idx")
  @@index([printerName, status, queuedAt], map: "print_jobs_printer_status_queued_at_idx")
  @@index([batchPageId, status], map: "print_jobs_batch_page_status_idx")
  @@index([productId, queuedAt], map: "print_jobs_product_id_queued_at_idx")
  @@map("print_jobs")
}

model MasterProductSyncRecord {
  id             BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  operationType  String                  @map("operation_type") @db.VarChar(32)
  productId      String?                 @map("product_id") @db.VarChar(128)
  sourceFileName String?                 @map("source_file_name") @db.VarChar(255)
  status         MasterProductSyncStatus @default(running)
  fetchedCount   Int                     @default(0) @map("fetched_count")
  createdCount   Int                     @default(0) @map("created_count")
  updatedCount   Int                     @default(0) @map("updated_count")
  executedBy     BigInt?                 @map("executed_by") @db.UnsignedBigInt
  operatorName   String?                 @map("operator_name") @db.VarChar(64)
  executedAt     DateTime                @default(now()) @map("executed_at")
  finishedAt     DateTime?               @map("finished_at")
  errorMessage   String?                 @map("error_message") @db.VarChar(255)
  operator       User?                   @relation(fields: [executedBy], references: [id])
  product        MasterProduct?          @relation(fields: [productId], references: [productId])

  @@index([operationType, executedAt], map: "idx_master_product_sync_records_operation_type_executed_at")
  @@index([status, executedAt], map: "idx_master_product_sync_records_status_executed_at")
  @@index([executedBy, executedAt], map: "idx_master_product_sync_records_executed_by_executed_at")
  @@index([productId, executedAt], map: "idx_master_product_sync_records_product_id_executed_at")
  @@map("master_product_sync_records")
}

model OperationAuditLog {
  id            BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  entityType    String         @map("entity_type") @db.VarChar(64)
  entityId      BigInt         @map("entity_id") @db.UnsignedBigInt
  action        AuditAction
  eventType     AuditEventType @map("event_type")
  beforeData    Json?          @map("before_data")
  afterData     Json?          @map("after_data")
  changedFields Json?          @map("changed_fields")
  operatorId    BigInt         @map("operator_id") @db.UnsignedBigInt
  requestId     String?        @map("request_id") @db.VarChar(64)
  remark        String?        @db.VarChar(255)
  createdAt     DateTime       @default(now()) @map("created_at")
  operator      User           @relation(fields: [operatorId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([operatorId, createdAt])
  @@index([eventType, createdAt])
  @@map("operation_audit_logs")
}
