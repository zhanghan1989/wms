generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  employee
  admin
  system_admin
}

enum ItemCodeStatus {
  in_stock
  outbound
  frozen
}

enum InboundOrderType {
  pending_batch
  manual_batch
  manual_single
}

enum OrderStatus {
  draft
  confirmed
  void
}

enum BatchInboundOrderStatus {
  waiting_upload
  waiting_inbound
  confirmed
  void
}

enum BatchInboundItemStatus {
  pending
  confirmed
}

enum FbaReplenishmentStatus {
  pending_confirm
  pending_outbound
  outbound
  deleted
}

enum ProductEditRequestStatus {
  pending
  confirmed
  deleted
}

enum StocktakeScopeType {
  sample
}

enum StocktakeTaskStatus {
  draft
  in_progress
  finished
  void
}

enum StocktakePlannerTaskStatus {
  pending
  confirming
  confirmed
  canceled
}

enum MovementType {
  inbound
  outbound
  stocktake_gain
  stocktake_loss
  adjust
}

enum OrderSendStatus {
  unsent
  sent
}

enum AuditAction {
  create
  update
  delete
}

enum AuditEventType {
  box_created
  box_field_updated
  box_renamed
  box_disabled
  box_deleted
  box_stock_increased
  box_stock_outbound
  sku_created
  sku_field_updated
  sku_disabled
  sku_deleted
  shelf_created
  shelf_field_updated
  shelf_disabled
  shelf_deleted
  brand_created
  brand_updated
  brand_deleted
  sku_type_created
  sku_type_updated
  sku_type_deleted
  shop_created
  shop_updated
  shop_deleted
  user_created
  user_updated
  user_disabled
  user_deleted
  inbound_order_created
  inbound_order_confirmed
  inbound_order_voided
  outbound_order_created
  outbound_order_confirmed
  outbound_order_voided
  stocktake_task_created
  stocktake_task_started
  stocktake_task_finished
  stocktake_task_voided
  inventory_adjust_created
  inventory_adjust_confirmed
  inventory_adjust_voided
}

enum MasterProductSyncStatus {
  running
  success
  failed
}

enum PrintJobStatus {
  pending
  claimed
  completed
  failed
  canceled
}

enum AmazonSpApiSyncType {
  fbm_orders
  fba_orders
  fba_inventory
  full
}

enum AmazonSpApiSyncStatus {
  running
  success
  partial
  failed
}

model User {
  id                             BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  username                       String                    @unique @db.VarChar(64)
  passwordHash                   String?                   @map("password_hash") @db.VarChar(255)
  passwordChangedAt              DateTime?                 @map("password_changed_at")
  mfaSecretEncrypted             String?                   @map("mfa_secret_encrypted") @db.Text
  mfaSecretIv                    String?                   @map("mfa_secret_iv") @db.VarChar(64)
  mfaSecretAuthTag               String?                   @map("mfa_secret_auth_tag") @db.VarChar(64)
  mfaEnabledAt                   DateTime?                 @map("mfa_enabled_at")
  role                           Role
  department                     String                    @default("china_warehouse") @db.VarChar(64)
  status                         Int                       @default(1) @db.TinyInt
  createdAt                      DateTime                  @default(now()) @map("created_at")
  updatedAt                      DateTime                  @updatedAt @map("updated_at")
  inboundOrders                  InboundOrder[]
  outboundOrders                 OutboundOrder[]
  stocktakeTasks                 StocktakeTask[]
  createdStocktakePlannerTasks   StocktakePlannerTask[]    @relation("stocktake_planner_created_by")
  confirmedStocktakePlannerTasks StocktakePlannerTask[]    @relation("stocktake_planner_confirmed_by")
  adjustOrders                   InventoryAdjustOrder[]
  batchInboundOrders             BatchInboundOrder[]
  createdFbaReplenishments       FbaReplenishment[]        @relation("fba_created_by")
  confirmedFbaReplenishments     FbaReplenishment[]        @relation("fba_confirmed_by")
  outboundFbaReplenishments      FbaReplenishment[]        @relation("fba_outbound_by")
  deletedFbaReplenishments       FbaReplenishment[]        @relation("fba_deleted_by")
  productEditRequests            ProductEditRequest[]      @relation("product_edit_created_by")
  stockMovements                 StockMovement[]
  auditLogs                      OperationAuditLog[]
  masterProductSyncRecords       MasterProductSyncRecord[]
  amazonSpApiOAuthStates         AmazonSpApiOAuthState[]

  @@map("users")
}

model DepartmentOption {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  code      String   @unique @db.VarChar(64)
  name      String   @db.VarChar(64)
  status    Int      @default(1) @db.TinyInt
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("department_options")
}

model RoleOption {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  code      Role     @unique
  name      String   @db.VarChar(64)
  status    Int      @default(1) @db.TinyInt
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("role_options")
}

model BatchInboundOrder {
  id                BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  orderNo           String                  @unique @map("order_no") @db.VarChar(64)
  status            BatchInboundOrderStatus
  expectedBoxCount  Int                     @map("expected_box_count")
  rangeStart        Int                     @map("range_start")
  rangeEnd          Int                     @map("range_end")
  collectedBoxCodes Json                    @map("collected_box_codes")
  uploadedFileName  String?                 @map("uploaded_file_name") @db.VarChar(255)
  domesticOrderNo   String?                 @map("domestic_order_no") @db.VarChar(128)
  seaOrderNo        String?                 @map("sea_order_no") @db.VarChar(128)
  remark            String?                 @db.VarChar(255)
  createdBy         BigInt                  @map("created_by") @db.UnsignedBigInt
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")
  creator           User                    @relation(fields: [createdBy], references: [id])
  items             BatchInboundItem[]

  @@map("batch_inbound_orders")
}

model BatchInboundItem {
  id          BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  orderId     BigInt                 @map("order_id") @db.UnsignedBigInt
  boxCode     String                 @map("box_code") @db.VarChar(128)
  productId   String                 @map("product_id") @db.VarChar(128)
  qty         Int
  sourceRowNo Int?                   @map("source_row_no")
  status      BatchInboundItemStatus @default(pending)
  confirmedAt DateTime?              @map("confirmed_at")
  createdAt   DateTime               @default(now()) @map("created_at")
  order       BatchInboundOrder      @relation(fields: [orderId], references: [id])

  @@unique([orderId, boxCode, productId], map: "uq_batch_order_box_product")
  @@index([orderId, status])
  @@index([orderId, boxCode])
  @@map("batch_inbound_items")
}

model Sku {
  id                  BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  productId           String?                    @map("product_id") @db.VarChar(128)
  sku                 String                     @db.VarChar(128)
  rbSku               String?                    @db.VarChar(128)
  asin                String?                    @db.VarChar(32)
  fnsku               String?                    @db.VarChar(32)
  fbmSku              String?                    @db.VarChar(128)
  shop                String                     @default("") @db.VarChar(128)
  remark              String?                    @db.VarChar(255)
  status              Int                        @default(1) @db.TinyInt
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")
  itemCodes           ItemCode[]
  outboundItems       OutboundOrderItem[]
  stocktakeRecords    StocktakeRecord[]
  stockMovements      StockMovement[]
  adjustItems         InventoryAdjustOrderItem[]
  fbaReplenishments   FbaReplenishment[]
  masterProduct       MasterProduct?             @relation(fields: [productId], references: [productId])
  productEditRequests ProductEditRequest[]

  @@unique([sku, shop], map: "skus_sku_shop_key")
  @@index([productId], map: "idx_skus_product_id")
  @@map("skus")
}

model Brand {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name      String   @unique @db.VarChar(128)
  status    Int      @default(1) @db.TinyInt
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("brands")
}

model SkuType {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name      String   @unique @db.VarChar(128)
  status    Int      @default(1) @db.TinyInt
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sku_types")
}

model Shop {
  id                     BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  name                   String                  @unique @db.VarChar(128)
  status                 Int                     @default(1) @db.TinyInt
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  amazonSpApiConnection  AmazonSpApiConnection?
  amazonSpApiOAuthStates AmazonSpApiOAuthState[]

  @@map("shops")
}

model AmazonSpApiConnection {
  id                     BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  shopId                 BigInt                   @unique @map("shop_id") @db.UnsignedBigInt
  sellerId               String                   @map("seller_id") @db.VarChar(64)
  region                 String                   @default("FE") @db.VarChar(8)
  marketplaceIds         Json                     @map("marketplace_ids")
  encryptedRefreshToken  String                   @map("encrypted_refresh_token") @db.Text
  tokenIv                String                   @map("token_iv") @db.VarChar(64)
  tokenAuthTag           String                   @map("token_auth_tag") @db.VarChar(64)
  authorizationMode      String                   @default("oauth") @map("authorization_mode") @db.VarChar(16)
  authorizedAt           DateTime?                @map("authorized_at")
  authorizationExpiresAt DateTime?                @map("authorization_expires_at")
  status                 Int                      @default(1) @db.TinyInt
  syncFbmOrders          Boolean                  @default(true) @map("sync_fbm_orders")
  syncFbaOrders          Boolean                  @default(true) @map("sync_fba_orders")
  syncFbaInventory       Boolean                  @default(true) @map("sync_fba_inventory")
  lastOrdersSyncedAt     DateTime?                @map("last_orders_synced_at")
  lastInventorySyncedAt  DateTime?                @map("last_inventory_synced_at")
  lastSuccessfulSyncAt   DateTime?                @map("last_successful_sync_at")
  lastSyncError          String?                  @map("last_sync_error") @db.Text
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")
  shop                   Shop                     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  syncRuns               AmazonSpApiSyncRun[]
  fbaOrderItems          AmazonFbaOrderItem[]
  fbaInventoryItems      AmazonFbaInventoryItem[]
  fbmOrderRecords        AmazonOrderRecord[]

  @@index([status])
  @@index([sellerId])
  @@map("amazon_sp_api_connections")
}

model AmazonSpApiOAuthState {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  stateHash        String    @unique @map("state_hash") @db.Char(64)
  shopId           BigInt    @map("shop_id") @db.UnsignedBigInt
  region           String    @default("FE") @db.VarChar(8)
  marketplaceIds   Json      @map("marketplace_ids")
  syncFbmOrders    Boolean   @default(true) @map("sync_fbm_orders")
  syncFbaOrders    Boolean   @default(true) @map("sync_fba_orders")
  syncFbaInventory Boolean   @default(true) @map("sync_fba_inventory")
  returnPath       String    @default("/") @map("return_path") @db.VarChar(255)
  expectedSellerId String?   @map("expected_seller_id") @db.VarChar(64)
  createdBy        BigInt    @map("created_by") @db.UnsignedBigInt
  expiresAt        DateTime  @map("expires_at")
  consumedAt       DateTime? @map("consumed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  shop             Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  creator          User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([shopId, expiresAt])
  @@index([expiresAt, consumedAt])
  @@map("amazon_sp_api_oauth_states")
}

model AmazonSpApiSyncRun {
  id           BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  connectionId BigInt                @map("connection_id") @db.UnsignedBigInt
  syncType     AmazonSpApiSyncType   @map("sync_type")
  status       AmazonSpApiSyncStatus @default(running)
  startedAt    DateTime              @default(now()) @map("started_at")
  finishedAt   DateTime?             @map("finished_at")
  fetchedCount Int                   @default(0) @map("fetched_count")
  createdCount Int                   @default(0) @map("created_count")
  updatedCount Int                   @default(0) @map("updated_count")
  errorMessage String?               @map("error_message") @db.Text
  connection   AmazonSpApiConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, startedAt])
  @@index([status, startedAt])
  @@map("amazon_sp_api_sync_runs")
}

model AmazonFbaOrderItem {
  id                BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  connectionId      BigInt                @map("connection_id") @db.UnsignedBigInt
  amazonOrderId     String                @map("amazon_order_id") @db.VarChar(64)
  amazonOrderItemId String                @map("amazon_order_item_id") @db.VarChar(64)
  marketplaceId     String?               @map("marketplace_id") @db.VarChar(32)
  sellerSku         String?               @map("seller_sku") @db.VarChar(128)
  asin              String?               @db.VarChar(32)
  productName       String?               @map("product_name") @db.Text
  orderStatus       String?               @map("order_status") @db.VarChar(32)
  quantityOrdered   Int                   @default(0) @map("quantity_ordered")
  quantityShipped   Int                   @default(0) @map("quantity_shipped")
  currency          String?               @db.VarChar(8)
  itemAmount        Decimal               @default(0) @map("item_amount") @db.Decimal(16, 2)
  purchaseDate      DateTime?             @map("purchase_date")
  lastUpdateDate    DateTime?             @map("last_update_date")
  rawPayload        Json?                 @map("raw_payload")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  connection        AmazonSpApiConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, amazonOrderId, amazonOrderItemId], map: "uq_amazon_fba_order_item")
  @@index([purchaseDate])
  @@index([sellerSku])
  @@index([orderStatus])
  @@index([orderStatus, purchaseDate], map: "idx_fba_orders_status_purchase")
  @@map("amazon_fba_order_items")
}

model AmazonFbaInventoryItem {
  id                  BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  connectionId        BigInt                @map("connection_id") @db.UnsignedBigInt
  marketplaceId       String                @map("marketplace_id") @db.VarChar(32)
  sellerSku           String                @map("seller_sku") @db.VarChar(128)
  fnSku               String?               @map("fn_sku") @db.VarChar(64)
  asin                String?               @db.VarChar(32)
  productName         String?               @map("product_name") @db.Text
  fulfillableQty      Int                   @default(0) @map("fulfillable_qty")
  inboundWorkingQty   Int                   @default(0) @map("inbound_working_qty")
  inboundShippedQty   Int                   @default(0) @map("inbound_shipped_qty")
  inboundReceivingQty Int                   @default(0) @map("inbound_receiving_qty")
  reservedQty         Int                   @default(0) @map("reserved_qty")
  unfulfillableQty    Int                   @default(0) @map("unfulfillable_qty")
  totalQty            Int                   @default(0) @map("total_qty")
  snapshotAt          DateTime              @map("snapshot_at")
  rawPayload          Json?                 @map("raw_payload")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  connection          AmazonSpApiConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, marketplaceId, sellerSku], map: "uq_amazon_fba_inventory_item")
  @@index([sellerSku])
  @@index([snapshotAt])
  @@map("amazon_fba_inventory_items")
}

model Shelf {
  id                    BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  shelfCode             String                 @unique @map("shelf_code") @db.VarChar(64)
  name                  String?                @db.VarChar(128)
  status                Int                    @default(1) @db.TinyInt
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  boxes                 Box[]
  stocktakePlannerTasks StocktakePlannerTask[]

  @@map("shelves")
}

model Box {
  id                       BigInt                      @id @default(autoincrement()) @db.UnsignedBigInt
  boxCode                  String                      @unique @map("box_code") @db.VarChar(128)
  shelfId                  BigInt                      @map("shelf_id") @db.UnsignedBigInt
  status                   Int                         @default(1) @db.TinyInt
  createdAt                DateTime                    @default(now()) @map("created_at")
  updatedAt                DateTime                    @updatedAt @map("updated_at")
  shelf                    Shelf                       @relation(fields: [shelfId], references: [id])
  itemCodes                ItemCode[]
  masterProductInventories MasterProductBoxInventory[]
  inboundItems             InboundOrderItem[]
  outboundItems            OutboundOrderItem[]
  stocktakeRecords         StocktakeRecord[]
  stockMovements           StockMovement[]
  adjustItems              InventoryAdjustOrderItem[]
  fbaReplenishments        FbaReplenishment[]

  @@map("boxes")
}

model ItemCode {
  id        BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  barcode   String         @unique @db.VarChar(128)
  skuId     BigInt         @map("sku_id") @db.UnsignedBigInt
  boxId     BigInt         @map("box_id") @db.UnsignedBigInt
  status    ItemCodeStatus @default(in_stock)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  sku       Sku            @relation(fields: [skuId], references: [id])
  box       Box            @relation(fields: [boxId], references: [id])

  @@index([boxId, status])
  @@map("item_codes")
}

model MasterProductBoxInventory {
  id        BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  boxId     BigInt        @map("box_id") @db.UnsignedBigInt
  productId String        @map("product_id") @db.VarChar(128)
  qty       Int           @default(0)
  updatedAt DateTime      @updatedAt @map("updated_at")
  box       Box           @relation(fields: [boxId], references: [id])
  product   MasterProduct @relation(fields: [productId], references: [productId])

  @@unique([boxId, productId])
  @@index([productId], map: "idx_master_product_box_inventory_product_id")
  @@map("master_product_box_inventory")
}

model InboundOrder {
  id        BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  orderNo   String             @unique @map("order_no") @db.VarChar(64)
  orderType InboundOrderType   @map("order_type")
  status    OrderStatus
  remark    String?            @db.VarChar(255)
  createdBy BigInt             @map("created_by") @db.UnsignedBigInt
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  creator   User               @relation(fields: [createdBy], references: [id])
  items     InboundOrderItem[]

  @@map("inbound_orders")
}

model InboundOrderItem {
  id          BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  orderId     BigInt        @map("order_id") @db.UnsignedBigInt
  boxId       BigInt        @map("box_id") @db.UnsignedBigInt
  productId   String        @map("product_id") @db.VarChar(128)
  qty         Int
  sourceRowNo Int?          @map("source_row_no")
  createdAt   DateTime      @default(now()) @map("created_at")
  order       InboundOrder  @relation(fields: [orderId], references: [id])
  box         Box           @relation(fields: [boxId], references: [id])
  product     MasterProduct @relation(fields: [productId], references: [productId])

  @@map("inbound_order_items")
}

model OutboundOrder {
  id        BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  orderNo   String              @unique @map("order_no") @db.VarChar(64)
  status    OrderStatus
  remark    String?             @db.VarChar(255)
  createdBy BigInt              @map("created_by") @db.UnsignedBigInt
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")
  creator   User                @relation(fields: [createdBy], references: [id])
  items     OutboundOrderItem[]

  @@map("outbound_orders")
}

model OutboundOrderItem {
  id        BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  orderId   BigInt        @map("order_id") @db.UnsignedBigInt
  boxId     BigInt        @map("box_id") @db.UnsignedBigInt
  skuId     BigInt        @map("sku_id") @db.UnsignedBigInt
  qty       Int
  createdAt DateTime      @default(now()) @map("created_at")
  order     OutboundOrder @relation(fields: [orderId], references: [id])
  box       Box           @relation(fields: [boxId], references: [id])
  sku       Sku           @relation(fields: [skuId], references: [id])

  @@map("outbound_order_items")
}

model StocktakeTask {
  id        BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  taskNo    String              @unique @map("task_no") @db.VarChar(64)
  scopeType StocktakeScopeType  @map("scope_type")
  status    StocktakeTaskStatus
  createdBy BigInt              @map("created_by") @db.UnsignedBigInt
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")
  creator   User                @relation(fields: [createdBy], references: [id])
  records   StocktakeRecord[]

  @@map("stocktake_tasks")
}

model StocktakePlannerTask {
  id          BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  taskNo      String                     @unique @map("task_no") @db.VarChar(64)
  plannedDate DateTime                   @map("planned_date") @db.Date
  shelfId     BigInt                     @map("shelf_id") @db.UnsignedBigInt
  status      StocktakePlannerTaskStatus @default(pending)
  createdBy   BigInt                     @map("created_by") @db.UnsignedBigInt
  confirmedBy BigInt?                    @map("confirmed_by") @db.UnsignedBigInt
  confirmedAt DateTime?                  @map("confirmed_at")
  createdAt   DateTime                   @default(now()) @map("created_at")
  updatedAt   DateTime                   @updatedAt @map("updated_at")
  shelf       Shelf                      @relation(fields: [shelfId], references: [id])
  creator     User                       @relation("stocktake_planner_created_by", fields: [createdBy], references: [id])
  confirmer   User?                      @relation("stocktake_planner_confirmed_by", fields: [confirmedBy], references: [id])

  @@index([plannedDate])
  @@index([shelfId])
  @@map("stocktake_planner_tasks")
}

model StocktakeRecord {
  id         BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  taskId     BigInt        @map("task_id") @db.UnsignedBigInt
  boxId      BigInt        @map("box_id") @db.UnsignedBigInt
  skuId      BigInt        @map("sku_id") @db.UnsignedBigInt
  systemQty  Int           @map("system_qty")
  countedQty Int           @map("counted_qty")
  diffQty    Int           @map("diff_qty")
  createdAt  DateTime      @default(now()) @map("created_at")
  task       StocktakeTask @relation(fields: [taskId], references: [id])
  box        Box           @relation(fields: [boxId], references: [id])
  sku        Sku           @relation(fields: [skuId], references: [id])

  @@map("stocktake_records")
}

model StockMovement {
  id           BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  movementType MovementType   @map("movement_type")
  refType      String         @map("ref_type") @db.VarChar(32)
  refId        BigInt         @map("ref_id") @db.UnsignedBigInt
  boxId        BigInt         @map("box_id") @db.UnsignedBigInt
  productId    String?        @map("product_id") @db.VarChar(128)
  skuId        BigInt?        @map("sku_id") @db.UnsignedBigInt
  qtyDelta     Int            @map("qty_delta")
